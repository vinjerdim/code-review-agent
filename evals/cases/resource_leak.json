  "head": {
    "src/loader.py": [
      "import json",
      "",
      "",
      "def load_config(path):",
      "    f = open(path)",
      "    data = json.load(f)",
      "    if \"version\" not in data:",
      "        raise ValueError(\"missing version\")",
      "    f.close()",
      "    return data"
    ]
  },
